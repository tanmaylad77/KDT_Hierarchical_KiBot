            color: '#000000'
          - layer: B.Cu
            color: '#E5E5E5'
          - layer: B.Mask
            color: '#CECECE'
          - layer: B.Paste
            color: '#CECECE'
          - layer: B.Silkscreen
            color: '#C7C7C7'
          - layer: B.Fab
            exclude_filter: 'only_testpoints'
            plot_footprint_values: false
            sketch_pads_on_fab_layers: false
            color: '#0B00CC'
          - layer: 'B.TestPointList'
            color: '#000000'

      - scaling: 1
        sheet: '%ln (Scale 1:1)'
        layer_var: '%ln (Scale 1:1)'
